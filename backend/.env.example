DB_HOST=localhost
DB_PORT=5432
DB_USER=inogov_user
DB_PASSWORD=change_me
DB_NAME=inogov_db_dev

SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Sperre: Fehlversuche:Minuten, kommagetrennt
LOCKOUT_TIERS=3:3,5:10,10:60

APP_NAME=inoGOV
COPYRIGHT_NAME=inoGOV
# true: Ortssuche und Stammdaten ohne Login lesbar, false: nur angemeldet
PUBLIC_SEARCH=true
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Gueltigkeit der Links
PASSWORD_RESET_MINUTES=60
ADMIN_LINK_HOURS=24

# ============================================================
# SMTP CONFIGURATION (Email)
# ============================================================
# Gmail: smtp.gmail.com (port 587, TLS)
# Office 365: smtp.office365.com (port 587, TLS)
# Postfix (local): localhost (port 25, no auth)
# Ohne SMTP_SERVER werden Mails nur ins Log der API geschrieben.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=inoGOV
